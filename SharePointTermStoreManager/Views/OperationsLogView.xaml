<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharePointTermStoreManager.Views.OperationsLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointTermStoreManager.Helpers"
    xmlns:m="using:SharePointTermStoreManager.Models"
    xmlns:v="using:SharePointTermStoreManager.Views">

    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <!-- The copy button in each entry's header: no fill or border until hovered. -->
        <Style x:Key="EntryCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Resources>

    <!-- The operations log: every change the app has made to the term store, newest first, read from the monthly
         JSON Lines files. Filters and the search box narrow the list; each entry expands to its JSON. -->
    <Grid Padding="16,12,16,16">
        <Border Padding="4,8,4,4" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title and commands, laid out as the term tree's header. -->
                <Grid Margin="12,0,4,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="{StaticResource FluentIconsFont}"
                            FontSize="20"
                            Glyph="{x:Bind h:FluentIcons.History}">
                            <FontIcon.RenderTransform>
                                <TranslateTransform Y="2" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Operations Log" />
                        <TextBlock
                            x:Name="CountText"
                            Margin="4,4,0,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ProgressRing x:Name="LoadingRing" Width="16" Height="16" VerticalAlignment="Center" IsActive="False" />
                    </StackPanel>
                    <CommandBar
                        x:Name="LogCommands"
                        Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right"
                        OverflowButtonVisibility="Auto">
                        <AppBarButton
                            Click="Refresh_Click"
                            Icon="{h:FluentIcon Icon=ArrowClockwise}"
                            Label="Refresh"
                            ToolTipService.ToolTip="Read the log files again (F5)">
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="ExpandAllButton"
                            Click="ExpandAll_Click"
                            Icon="{h:FluentIcon Icon=TextBulletListLtr}"
                            Label="Expand all"
                            ToolTipService.ToolTip="Show the JSON of every entry shown" />
                        <AppBarButton
                            x:Name="CollapseAllButton"
                            Click="CollapseAll_Click"
                            Icon="{h:FluentIcon Icon=TextDensity}"
                            Label="Collapse all"
                            ToolTipService.ToolTip="Show only each entry's summary" />
                        <AppBarButton
                            x:Name="CopyButton"
                            Icon="{h:FluentIcon Icon=Copy}"
                            Label="Copy"
                            ToolTipService.ToolTip="Copy the entries shown to the clipboard">
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="CopyJsonLines_Click" Text="Copy as JSON Lines (as in the file)" />
                                    <MenuFlyoutItem Click="CopyFormatted_Click" Text="Copy as formatted JSON" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton
                            x:Name="OpenFileButton"
                            Icon="{h:FluentIcon Icon=Open}"
                            Label="Open log file"
                            ToolTipService.ToolTip="Open a raw .jsonl log file (one file per month)">
                            <AppBarButton.Flyout>
                                <MenuFlyout x:Name="OpenFileMenu" Placement="BottomEdgeAlignedRight" Opening="OpenFileMenu_Opening" />
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>
                </Grid>

                <!-- Filters. They wrap onto more rows when the window is narrow. -->
                <v:WrapPanel
                    x:Name="FilterPanel"
                    Grid.Row="1"
                    Margin="12,0,12,4"
                    HorizontalSpacing="12"
                    VerticalSpacing="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Search" />
                        <AutoSuggestBox
                            x:Name="SearchBox"
                            Width="280"
                            AutomationProperties.Name="Search the operations log"
                            PlaceholderText="Search names, paths, IDs, errors…"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Date" />
                        <ComboBox x:Name="DateBox" MinWidth="150" AutomationProperties.Name="Date" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <x:String>Any date</x:String>
                            <x:String>Today</x:String>
                            <x:String>Last 7 days</x:String>
                            <x:String>Last 30 days</x:String>
                            <x:String>This month</x:String>
                            <x:String>Custom range</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="FromPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="From" />
                        <CalendarDatePicker x:Name="FromDate" MinWidth="150" AutomationProperties.Name="From date" DateChanged="Date_Changed" PlaceholderText="First entry" />
                    </StackPanel>
                    <StackPanel x:Name="ToPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="To" />
                        <CalendarDatePicker x:Name="ToDate" MinWidth="150" AutomationProperties.Name="To date" DateChanged="Date_Changed" PlaceholderText="Last entry" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Action" />
                        <ComboBox x:Name="ActionBox" MinWidth="150" AutomationProperties.Name="Action" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Outcome" />
                        <ComboBox x:Name="OutcomeBox" MinWidth="140" AutomationProperties.Name="Outcome" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <x:String>Any outcome</x:String>
                            <x:String>Succeeded</x:String>
                            <x:String>Failed</x:String>
                            <x:String>Started</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Term group" />
                        <ComboBox x:Name="GroupBox" MinWidth="170" MaxWidth="280" AutomationProperties.Name="Term group" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <!-- Only shown when the log has entries from more than one site. -->
                    <StackPanel x:Name="SitePanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FilterLabelStyle}" Text="Site" />
                        <ComboBox x:Name="SiteBox" MinWidth="170" MaxWidth="320" AutomationProperties.Name="Site" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <Button
                        x:Name="ClearFiltersButton"
                        Margin="0,22,0,0"
                        Click="ClearFilters_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Show every entry">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.FilterDismiss}" />
                            <TextBlock Text="Clear filters" />
                        </StackPanel>
                    </Button>
                </v:WrapPanel>

                <!-- The entries. -->
                <ScrollViewer x:Name="EntriesScroller" Grid.Row="2" Padding="12,0,12,8">
                    <ItemsRepeater x:Name="Entries">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="m:LogEntry">
                                <Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Outcome: green tick, red cross, or a clock for "started". -->
                                            <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="{x:Bind h:FluentIcons.CheckmarkCircle}" Visibility="{x:Bind SucceededVisibility}" />
                                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="{x:Bind h:FluentIcons.ErrorCircle}" Visibility="{x:Bind FailedVisibility}" />
                                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind h:FluentIcons.History}" Visibility="{x:Bind OtherOutcomeVisibility}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Error}"
                                                    TextTrimming="CharacterEllipsis"
                                                    Visibility="{x:Bind ErrorVisibility}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right" Text="{x:Bind TimeText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind OutcomeText}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="3"
                                                VerticalAlignment="Top"
                                                AutomationProperties.Name="Copy this entry"
                                                Click="CopyEntry_Click"
                                                Style="{StaticResource EntryCopyButtonStyle}"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Copy this entry as formatted JSON">
                                                <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.Copy}" />
                                            </Button>
                                        </Grid>
                                    </Expander.Header>
                                    <v:JsonView Entry="{x:Bind}" />
                                </Expander>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Nothing logged yet, or nothing matching the filters. -->
                <StackPanel
                    x:Name="EmptyState"
                    Grid.Row="2"
                    MaxWidth="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="EmptyIcon"
                        HorizontalAlignment="Center"
                        FontFamily="{StaticResource FluentIconsFont}"
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="{x:Bind h:FluentIcons.History}" />
                    <TextBlock
                        x:Name="EmptyText"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
