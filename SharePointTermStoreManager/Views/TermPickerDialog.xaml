<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SharePointTermStoreManager.Views.TermPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointTermStoreManager.Helpers"
    xmlns:m="using:SharePointTermStoreManager.Models"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Select"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="680" Height="500" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <Grid x:Name="SearchRow" Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search terms"
                PlaceholderText="Search labels and synonyms (starts with)…"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="ScopeBox" Grid.Column="1" MinWidth="200" AutomationProperties.Name="Search in" SelectionChanged="ScopeBox_SelectionChanged" />
        </Grid>

        <Border Grid.Row="2" Padding="4" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <TreeView
                    x:Name="BrowseTree"
                    Expanding="BrowseTree_Expanding"
                    ItemInvoked="BrowseTree_ItemInvoked"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="m:TermNode">
                            <TreeViewItem
                                AutomationProperties.Name="{x:Bind Name}"
                                HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
                                ItemsSource="{x:Bind Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Grid>
                                        <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind Glyph, Mode=OneWay}" Visibility="{x:Bind h:TermIcons.OutlineVisibility(h:DisplayOptions.Current.UseColorfulIcons, Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" />
                                        <FontIcon FontFamily="{StaticResource FluentIconsFilledFont}" FontSize="16" Foreground="{x:Bind h:TermIcons.Color(Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" Glyph="{x:Bind h:TermIcons.Filled(Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" Visibility="{x:Bind h:TermIcons.ColorVisibility(h:DisplayOptions.Current.UseColorfulIcons, Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" />
                                    </Grid>
                                    <TextBlock Opacity="{x:Bind TextOpacity}" Text="{x:Bind Name}" />
                                    <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsLoading, Mode=OneWay}" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <ListView
                    x:Name="ResultsList"
                    SelectionChanged="ResultsList_SelectionChanged"
                    SelectionMode="Single"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:ItemRef">
                            <Grid Padding="0,6" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,2,0,0" VerticalAlignment="Top">
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind Glyph}" Visibility="{x:Bind h:TermIcons.OutlineVisibility(h:DisplayOptions.Current.UseColorfulIcons, Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" />
                                    <FontIcon FontFamily="{StaticResource FluentIconsFilledFont}" FontSize="16" Foreground="{x:Bind h:TermIcons.Color(Kind, IsDeprecated, IsReused, IsPinned)}" Glyph="{x:Bind h:TermIcons.Filled(Kind, IsDeprecated, IsReused, IsPinned)}" Visibility="{x:Bind h:TermIcons.ColorVisibility(h:DisplayOptions.Current.UseColorfulIcons, Kind, IsDeprecated, IsReused, IsPinned), Mode=OneWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Opacity="{x:Bind TextOpacity}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Badges}" />
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Path}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressRing x:Name="LoadingRing" IsActive="False" />
                    <TextBlock x:Name="EmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Spacing="2">
            <TextBlock x:Name="SelectionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Nothing selected yet." TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ProblemText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</ContentDialog>
