<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SharePointTermStoreManager.Views.ExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointTermStoreManager.Helpers">

    <UserControl.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,2" />
        </Style>
        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FormatTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FormatCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!-- Export: writes the whole term store (or chosen term groups), read fresh from SharePoint, to a file. -->
    <Grid Padding="16,12,16,16">
        <Border Padding="4,8,4,4" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title, laid out as the term tree's and the log's headers (40px tall, like their command bars). -->
                <StackPanel Height="40" Margin="12,0,4,0" Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="{StaticResource FluentIconsFont}"
                        FontSize="20"
                        Glyph="{x:Bind h:FluentIcons.ArrowExportLtr}">
                        <FontIcon.RenderTransform>
                            <TranslateTransform Y="2" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Export" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="820" Padding="16,0,16,16" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="Save the term store to a file: term groups, term sets and every term, with descriptions, synonyms, labels in other languages, custom properties, settings, dates and IDs. It's read fresh from SharePoint, so it includes terms you haven't opened in the tree." />

                        <InfoBar
                            x:Name="NotConnectedBar"
                            Margin="0,8,0,0"
                            IsClosable="False"
                            IsOpen="True"
                            Message="Connect to the term store on the Term Store page, then come back here to export it."
                            Severity="Informational" />

                        <!-- ===== Format ===== -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Format" />
                        <StackPanel Spacing="6">
                            <RadioButton x:Name="ExcelRadio" GroupName="Format" Tag="Excel">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormatTitleStyle}" Text="Excel workbook (.xlsx)" />
                                    <TextBlock Style="{StaticResource FormatCaptionStyle}" Text="One row per term group, term set and term, in an Excel table you can sort and filter." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CsvRadio" GroupName="Format" Tag="Csv">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormatTitleStyle}" Text="CSV (.csv)" />
                                    <TextBlock Style="{StaticResource FormatCaptionStyle}" Text="The same rows as the Excel workbook, as comma-separated text (UTF-8) for other tools and scripts." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="JsonRadio" GroupName="Format" Tag="Json">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormatTitleStyle}" Text="JSON (.json)" />
                                    <TextBlock Style="{StaticResource FormatCaptionStyle}" Text="The whole tree, nested as in the term store and pretty-printed, with every item's details." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="HtmlRadio" GroupName="Format" Tag="Html">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FormatTitleStyle}" Text="Web page (.html)" />
                                    <TextBlock Style="{StaticResource FormatCaptionStyle}" Text="A single page with a collapsible tree, search and a details pane. Opens in any browser, offline, so it's easy to share." />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- ===== Term groups ===== -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Term groups" />
                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="Each term group is exported with all its term sets and terms." />
                        <StackPanel x:Name="GroupCommands" Margin="-12,-4,0,0" Orientation="Horizontal">
                            <HyperlinkButton Click="SelectAllGroups_Click" Content="Select all" />
                            <HyperlinkButton Click="ClearGroups_Click" Content="Clear" />
                        </StackPanel>
                        <Border
                            Padding="12,4"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <Grid>
                                <ScrollViewer MaxHeight="260">
                                    <StackPanel x:Name="GroupList" />
                                </ScrollViewer>
                                <TextBlock
                                    x:Name="NoGroupsText"
                                    Margin="0,6"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Connect to choose term groups." />
                            </Grid>
                        </Border>

                        <!-- ===== Options ===== -->
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Options" />
                        <CheckBox x:Name="IncludeDeprecatedBox" Click="Option_Click">
                            <StackPanel>
                                <TextBlock Text="Include deprecated terms" />
                                <TextBlock Style="{StaticResource FormatCaptionStyle}" Text="Leaving them out also leaves out the terms below them." />
                            </StackPanel>
                        </CheckBox>

                        <!-- ===== Export ===== -->
                        <StackPanel Margin="0,24,0,0" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource FluentIconsFont}" FontSize="16" Glyph="{x:Bind h:FluentIcons.ArrowExportLtr}" />
                                    <TextBlock Text="Export…" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelButton" Click="Cancel_Click" Content="Cancel" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="ProgressPanel" Margin="0,16,0,0" Spacing="6" Visibility="Collapsed">
                            <ProgressBar x:Name="ExportProgressBar" IsIndeterminate="True" />
                            <TextBlock x:Name="ProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar x:Name="ResultBar" Margin="0,16,0,0" IsClosable="True">
                            <InfoBar.Content>
                                <StackPanel x:Name="ResultActions" Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                                    <Button Click="OpenFile_Click" Content="Open file" />
                                    <Button Click="ShowInFolder_Click" Content="Show in folder" />
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
