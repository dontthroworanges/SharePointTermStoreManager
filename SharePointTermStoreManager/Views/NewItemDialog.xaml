<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SharePointTermStoreManager.Views.NewItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointTermStoreManager.Helpers"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Create"
    Style="{StaticResource DefaultContentDialogStyle}">

    <StackPanel MinWidth="420" Spacing="14">
        <TextBlock x:Name="LocationText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
            <TextBox x:Name="NameBox" Header="Name" MaxLength="255" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Can't contain ; &quot; &lt; &gt; or |. An &amp; is stored as ＆, as in SharePoint."
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBox
            x:Name="DescriptionBox"
            MinHeight="64"
            AcceptsReturn="True"
            Header="Description (optional)"
            MaxLength="1000"
            TextWrapping="Wrap" />
        <InfoBar x:Name="ErrorBar" IconSource="{h:FluentIconSource Icon=ErrorCircle}" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
