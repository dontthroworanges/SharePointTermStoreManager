<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SharePointTermStoreManager.Views.ProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:SharePointTermStoreManager.Helpers"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    PrimaryButtonText="Save"
    Style="{StaticResource DefaultContentDialogStyle}">

    <ScrollViewer MinWidth="440" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="A profile is a SharePoint Online site plus the account used to manage its term store. Any site in the tenant opens the tenant term store; use a specific site collection URL to also see that site's own term groups."
                TextWrapping="Wrap" />

            <TextBox
                x:Name="SiteUrlBox"
                Header="SharePoint site URL"
                InputScope="Url"
                PlaceholderText="https://contoso.sharepoint.com"
                TextChanged="SiteUrlBox_TextChanged" />

            <TextBox x:Name="NameBox" Header="Profile name" PlaceholderText="Defaults to the tenant name, e.g. contoso" />

            <InfoBar
                IconSource="{h:FluentIconSource Icon=Info}"
                IsClosable="False"
                IsOpen="True"
                Message="A Microsoft sign-in window opens the first time, then you stay signed in. No app registration is needed. Your account needs term store permissions to make changes."
                Severity="Informational" />

            <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Advanced">
                <StackPanel Spacing="14">
                    <TextBox
                        x:Name="TenantBox"
                        Header="Tenant (optional)"
                        PlaceholderText="Worked out from the site URL" />
                    <StackPanel Spacing="4">
                        <TextBox
                            x:Name="ClientIdBox"
                            Header="App (client) ID (optional)"
                            PlaceholderText="Leave empty to use the built-in SharePoint Online sign-in" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Only if your organization gives you its own app registration (redirect URI http://localhost). Sign-in then uses your default web browser instead."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <InfoBar x:Name="ErrorBar" IconSource="{h:FluentIconSource Icon=ErrorCircle}" IsClosable="False" Severity="Error" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
